{
  "name": "hearts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "dev": "pnpm --filter @hearts/web build && pnpm --filter @hearts/server dev",
    "dev:web": "pnpm --filter @hearts/web dev",
    "dev:node": "pnpm --filter @hearts/web build && pnpm --filter @hearts/server start:node",
    "build": "pnpm --filter @hearts/web build",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "storybook": "pnpm --filter @hearts/ui storybook",
    "build-storybook": "pnpm --filter @hearts/ui build-storybook",
    "deploy": "pnpm build && pnpm --filter @hearts/server deploy"
  },
  "devDependencies": {
    "typescript": "^5.8",
    "vitest": "3"
  },
  "license": "GPL-3.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}